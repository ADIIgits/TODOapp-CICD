PORT=5001
# Replace with your actual MongoDB Atlas Connection String:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/todo_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/todo_app?retryWrites=true&w=majority
NODE_ENV=development
CLIENT_ORIGIN=*
